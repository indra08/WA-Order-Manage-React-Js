# ==========================================
# WA Book Order System - Environment Config
# ==========================================

# App
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Admin auth (dipakai di semua endpoint /api/admin/*)
# Kirim header:  x-admin-token: <ADMIN_TOKEN>
ADMIN_TOKEN=change-this-admin-token

# Webhook (dipakai untuk endpoint /api/monitor/webhook)
# Jika DRIPSENDER_WEBHOOK_SECRET diisi, request webhook wajib menyertakan
# header x-dripsender-signature (HMAC SHA256 dari raw body memakai secret ini).
# Kosongkan saat development jika belum ada signature dari provider.
DRIPSENDER_WEBHOOK_SECRET=

# DripSender (opsional, hanya dipakai jika nanti mau kirim balasan otomatis)
DRIPSENDER_API_KEY=

# Google Sheets (opsional, placeholder untuk integrasi lanjutan)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Data storage (file JSON, tanpa perlu install database eksternal)
DATA_DIR=./data
